{
  "name": "@wous/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "build": "wrangler deploy --dry-run --outdir dist --env=\"\"",
    "typecheck": "pnpm cf-typegen && tsc -p tsconfig.json",
    "test": "vitest run",
    "cf-typegen": "wrangler types --env-interface Env",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "deploy:staging": "wrangler d1 migrations apply DB --remote --env staging && wrangler deploy --env staging --secrets-file secrets.staging.json",
    "deploy:production": "wrangler d1 migrations apply DB --remote --env production && wrangler deploy --env production --secrets-file secrets.production.json"
  },
  "dependencies": {
    "@wous/config": "workspace:*",
    "@wous/contracts": "workspace:*",
    "hono": "4.13.9",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "typescript": "6.0.3",
    "vitest": "4.1.11",
    "wrangler": "4.141.0"
  }
}
