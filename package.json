{
  "name": "wous",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @wous/worker --filter @wous/web dev",
    "build": "pnpm --filter @wous/web build && pnpm --filter @wous/worker build",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "test:e2e": "pnpm --filter @wous/e2e e2e",
    "db:migrate:local": "pnpm --filter @wous/worker db:migrate:local",
    "deploy:staging": "pnpm build && pnpm --filter @wous/worker deploy:staging",
    "deploy:production": "pnpm build && pnpm --filter @wous/worker deploy:production"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "typescript": "6.0.3"
  }
}
